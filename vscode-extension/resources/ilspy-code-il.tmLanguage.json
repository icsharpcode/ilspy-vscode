					"end": "$",
					"patterns": [
						{
							"include": "#comment-markers"
						}
					]
				},
				{
					"name": "comment.block.ilspy-code-il",
					"begin": "/\\*",
					"end": "\\*/",
					"patterns": [
						{
							"include": "#comment-markers"
						}
					]
				}
			]
		},
		"comment-markers": {
			"match": "(?<![A-Za-z0-9_])(?:TODO|FIXME|HACK|UNDONE)(?![A-Za-z0-9_])",
