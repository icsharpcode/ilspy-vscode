		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.ilspy-code-il",
					"begin": "\"",
					"end": "\""
				},
				{
					"name": "string.quoted.single.ilspy-code-il",
					"begin": "'",
					"end": "'"
				}
			]
